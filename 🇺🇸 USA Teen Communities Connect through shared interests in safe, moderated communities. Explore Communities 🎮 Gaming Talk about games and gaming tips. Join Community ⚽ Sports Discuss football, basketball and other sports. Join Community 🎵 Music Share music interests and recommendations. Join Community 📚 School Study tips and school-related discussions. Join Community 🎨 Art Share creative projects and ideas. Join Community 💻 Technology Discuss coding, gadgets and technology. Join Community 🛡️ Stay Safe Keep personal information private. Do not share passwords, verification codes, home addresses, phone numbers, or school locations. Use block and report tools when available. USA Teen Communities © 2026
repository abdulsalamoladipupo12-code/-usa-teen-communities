<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>USA Teen Communities</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      background: #f3f6fb;
      color: #172033;
    }

    header {
      background: #1d4ed8;
      color: white;
      text-align: center;
      padding: 35px 15px;
    }

    .container {
      max-width: 900px;
      margin: 25px auto;
      padding: 15px;
    }

    .community {
      background: white;
      margin: 15px 0;
      padding: 20px;
      border-radius: 12px;
      text-align: center;
    }

    button {
      background: #2563eb;
      color: white;
      border: 0;
      padding: 10px 20px;
      border-radius: 8px;
    }

    .safety {
      background: white;
      padding: 20px;
      border-left: 5px solid #22c55e;
      border-radius: 10px;
    }
  </style>
</head>

<body>

<header>
  <h1>🇺🇸 USA Teen Communities</h1>
  <p>Connect through shared interests</p>
</header>

<div class="container">

  <div class="community">
    <h2>🎮 Gaming</h2>
    <p>Talk about your favorite games.</p>
    <button>Join Community</button>
  </div>

  <div class="community">
    <h2>⚽ Sports</h2>
    <p>Talk about football, basketball and sports.</p>
    <button>Join Community</button>
  </div>

  <div class="community">
    <h2>🎵 Music</h2>
    <p>Discuss music and your favorite artists.</p>
    <button>Join Community</button>
  </div>

  <div class="community">
    <h2>📚 School</h2>
    <p>Share study tips and school interests.</p>
    <button>Join Community</button>
  </div>

  <div class="safety">
    <h2>🛡️ Stay Safe</h2>
    <p>
      Never share your password, home address, phone number,
      or other private information with people online.
    </p>
  </div>

</div>

</body>
</html>
